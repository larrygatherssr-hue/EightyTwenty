# EightyTwenty — environment configuration
# TEST MODE ONLY. Never put live keys (sk_live_ / pk_live_) in this file.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Stripe TEST keys (from the Stripe Dashboard > Developers > API keys, with
# "Viewing test data" ON). The app REFUSES to start with live keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secrets (Stripe Dashboard > Developers > Webhooks).
# One endpoint per secret. The Connect endpoint must be created with
# "Listen to events on Connected accounts" enabled.
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Public base URL of the deployed app (used for Stripe redirects + webhooks).
# Local dev: http://localhost:3000
BASE_URL=http://localhost:3000

# Admin dashboard password (choose a strong one; used for /admin login).
ADMIN_PASSWORD=change-me

# SQLite database file (relative to the app root).
DATABASE_PATH=./data/marketplace.db

# Port the server listens on (Render sets PORT automatically).
PORT=3000
